# Copiar este archivo como ".env" en el servidor de producción (Hostinger) y
# completar con las credenciales reales. En local (WAMP) no es necesario crear
# este archivo: si no existe, la app usa los valores por defecto de config/.

APP_ENV=production
APP_DEBUG=0
APP_TIMEZONE=America/Bogota
# URL pública del sistema, con https y sin barra final (ej. https://sigebi.midominio.com).
# OBLIGATORIA en producción: con ella se arman el enlace del correo de "olvidé mi
# contraseña" y el contenido de los códigos QR. Si queda vacía se usa el dominio que envía
# el navegador, lo que permite falsificar el enlace del correo.
# OJO: los QR ya impresos contienen esta URL; si cambia el dominio, dejan de funcionar.
APP_URL=
# Llave de 32 bytes (base64) que cifra las claves de la verificación en dos pasos.
# Generarla UNA vez con:  php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# (deploy-hostinger.sh la genera sola si falta). GUÁRDELA TAMBIÉN FUERA DEL SERVIDOR y no
# la cambie: si se pierde o cambia, nadie pierde datos, pero quienes tenían la verificación
# en dos pasos deben entrar con un código de recuperación y configurarla de nuevo. Sin ella,
# la verificación en dos pasos no está disponible (no se exige a nadie).
APP_KEY=

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Correo SMTP, usado para el enlace de "olvidé mi contraseña".
# En Hostinger: crea una cuenta en hPanel -> Correos electrónicos (ej. noreply@ediertech.com)
# y usa esos mismos datos aquí. MAIL_HOST suele ser algo como "smtp.hostinger.com".
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=SIGEBI

# Carpeta donde se guardan las fotos/PDFs/Excel que suben los usuarios. Déjala vacía
# para usar la carpeta "storage" del propio proyecto (comportamiento por defecto).
# IMPORTANTE si usas "Auto Deploy" de Git en Hostinger: ese redespliegue borra los
# archivos que no estén en el repositorio cada vez que se actualiza el código, así que
# aquí conviene apuntar a una ruta ABSOLUTA fuera de la carpeta que gestiona el
# despliegue (ej. /home/tu_usuario/storage_sigebi), para que nunca se borre.
STORAGE_PATH=

# Respaldo automático de la base de datos (database/respaldo.php, pensado para un
# cron job diario). Sin BACKUP_EMAIL, el respaldo se genera igual y se guarda en
# storage/backups/, pero solo en este servidor -sin copia externa, no protege contra
# una falla del servidor o del hosting-. Puede ser el correo del rector, del
# superusuario, o uno dedicado solo a recibir respaldos.
BACKUP_EMAIL=
# Contraseña para CIFRAR la copia que se envía por correo (AES-256). Sin ella, el
# respaldo NO se envía por correo. Use una frase larga y GUÁRDELA TAMBIÉN FUERA DEL
# SERVIDOR (p. ej. en un gestor de contraseñas): sin ella, las copias recibidas por
# correo no se pueden abrir. Para abrir una copia en cualquier equipo:
#   openssl enc -d -aes-256-cbc -pbkdf2 -iter 200000 -md sha256 -in archivo.sql.gz.enc -out archivo.sql.gz
BACKUP_PASSWORD=
# Cuántos días se guardan los respaldos LOCALES en storage/backups/ antes de
# borrarlos (no afecta las copias ya enviadas por correo).
BACKUP_RETENCION_DIAS=14
