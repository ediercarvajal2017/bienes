# Copia este archivo a .env.test (está en .gitignore) solo si necesitas cambiar algo.
# Sin .env.test la suite funciona con XAMPP en Windows tal como viene.
#
# MODO LOCAL (por defecto): Playwright levanta su propio servidor PHP (127.0.0.1:8090)
# contra una base DESECHABLE que recrea en cada corrida con datos conocidos
# (database/seeders/pruebas.php). No usa Apache ni la base de desarrollo.

# Ejecutables (por defecto, los de XAMPP en Windows; "php"/"mysql" en otros sistemas).
#PHP_BIN=C:/xampp/php/php.exe
#MYSQL_BIN=C:/xampp/mysql/bin/mysql.exe

# Base de pruebas: debe contener "test" (se BORRA y se recrea en cada corrida).
#TEST_DB_DATABASE=sigebi_test
#TEST_PUERTO=8090

# Usar el Edge/Chrome instalado en vez de los navegadores de "npx playwright install".
#PW_CANAL=msedge

# MODO REMOTO (opcional, solo ensayo/demo, NUNCA producción): el dominio debe contener
# staging, ensayo o demo, y hay que activarlo a propósito.
#TEST_BASE_URL=https://demo.midominio.com/
#TEST_PERMITIR_REMOTO=1
#TEST_USER_EMAIL=
#TEST_USER_PASSWORD=
