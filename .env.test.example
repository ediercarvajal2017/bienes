# Copia este archivo a .env.test (que ya está en .gitignore, nunca se sube) y completa
# con una cuenta real de tu entorno de DESARROLLO local. No uses una cuenta de producción.

# URL base de tu SIGEBI local (WAMP). Ajusta el puerto/ruta si tu instalación es distinta.
TEST_BASE_URL=http://localhost/gestionbienes

# Cuenta para las pruebas autenticadas (carga_masiva.spec.js).
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# papelera.spec.js exige que la cuenta de arriba sea SUPERUSUARIO
# (/papelera y /auditoria están protegidas por SuperusuarioMiddleware).
