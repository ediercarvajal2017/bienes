# Dependencias (se restauran con `composer install` a partir de composer.lock)
/vendor/

# Configuración local / credenciales de entorno
.env
.env.test

# Playwright (pruebas de navegador) — ver .env.test.example para configurar
/node_modules/
/playwright-report/
/test-results/
/playwright/.auth/

# Archivos subidos por los usuarios (fotos, PDFs, Excel de cargas masivas) y logs
/storage/uploads/*
!/storage/uploads/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep

# Respaldos de la base de datos generados por database/respaldo.php
/storage/backups/*
!/storage/backups/.gitkeep

# Archivos de sesión de PHP (ver App\Core\Session::start)
/storage/sesiones/

# Informes de database/diagnostico_integridad.php y conteos de la prueba de humo:
# contienen datos reales de producción, nunca se versionan.
/storage/diagnosticos/

# Registros de auditoría archivados por database/archivar_auditoria.php
/storage/archivo_auditoria/*
!/storage/archivo_auditoria/.gitkeep

# Herramientas locales
/.claude/
/build/

# Sistema operativo / editores
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
.worktrees/

# Archivos de espacio de trabajo de VS Code (no deben quedar dentro del proyecto versionado)
*.code-workspace

# Modo mantenimiento (lo crea y lo borra deploy-hostinger.sh durante cada despliegue)
/public/mantenimiento.flag

# Suite de pruebas: archivos subidos y datos generados en cada corrida
/storage/pruebas/
/playwright/.datos-prueba.json
